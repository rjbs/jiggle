#!/usr/bin/env perl
use v5.36;

use FindBin;
use lib "$FindBin::Bin/../lib";

use Getopt::Long::Descriptive;
use HTML::Entities ();
use JSON::MaybeXS ();
use Jiggle::Library;
use Path::Tiny ();

=head1 NAME

private-contact-sheet - a local page of every private photo, for review

=head1 SYNOPSIS

  tools/private-contact-sheet --library LIBRARY --out ~/Desktop/private.html

=head1 DESCRIPTION

This writes one HTML page showing every private photo in the library, with
its title, date, albums, and (for imported photos) its privacy level on
Flickr, grouped by that level.  It's for deciding which private photos
needn't be.  To make one public, change its C<visibility> in the metadata
file the page links to, then build.

The page shows each photo's C<h480> rendition from F<derived/>, by
C<file://> URL, so it works only on the machine with the library.  It
refuses to write into the library's F<site/>, so it can never be published
by a sync.

=cut

my ($opt, $usage) = describe_options(
  '%c %o',
  [ 'library=s', 'the jiggle library', { required => 1 } ],
  [ 'out=s',     'where to write the page', { required => 1 } ],
);

my $library = Jiggle::Library->new({ root => $opt->library });
my $out     = Path::Tiny::path($opt->out)->absolute;

my $site = $library->root->child('site')->realpath;
die "refusing to write inside $site, which gets published\n"
  if $site->subsumes($out->parent->realpath);

my $JSON = JSON::MaybeXS->new;

my %albums_of;
for my $album ($library->albums) {
  push $albums_of{$_}->@*, $album->title for $album->photos->@*;
}

# Flickr's own privacy level, from the raw record kept at import.
sub flickr_privacy ($photo) {
  my $id = $photo->flickr_id or return 'not from Flickr';
  my $record = $library->flickr_dir->child("$id.json");
  return 'private' unless -e $record;
  return $JSON->decode($record->slurp_raw)->{privacy} // 'private';
}

my %group;
for my $photo (grep {; ! $_->is_public } $library->photos) {
  push $group{ flickr_privacy($photo) }->@*, $photo;
}

my @order = sort {;
  ($a eq 'friend & family' ? 0 : 1) <=> ($b eq 'friend & family' ? 0 : 1) || $a cmp $b
} keys %group;

my $h = sub ($s) { HTML::Entities::encode_entities($s // '', q{<>&"'}) };

my $total = 0;
my @sections;
for my $level (@order) {
  my @photos = sort {; ($a->taken // '') cmp ($b->taken // '') || $a->id cmp $b->id } $group{$level}->@*;
  $total += @photos;

  my @tiles = map {;
    my $photo  = $_;
    my $thumb  = $library->derived_path($photo->id, 'h480.webp');
    my $meta   = $library->meta_path($photo->id);
    my $albums = join '; ', ($albums_of{ $photo->id } // [])->@*;
    my $date   = substr($photo->taken // 'undated', 0, 10);

    qq{<figure>}
    . (-e $thumb ? qq{<a href="file://$thumb"><img src="file://$thumb" loading="lazy" alt=""></a>}
                 : qq{<div class="none">no rendition</div>})
    . qq{<figcaption><b>} . $h->(length $photo->title ? $photo->title : '(untitled)') . qq{</b><br>}
    . $h->($date) . ($photo->is_video ? ' &middot; video' : '')
    . (length $albums ? '<br><i>' . $h->($albums) . '</i>' : '')
    . qq{<br><a class="id" href="file://$meta">} . $photo->id . qq{</a></figcaption></figure>};
  } @photos;

  push @sections, sprintf qq{<h2>%s <span>%d</span></h2>\n<div class="grid">\n%s\n</div>},
    $h->($level), scalar @photos, join "\n", @tiles;
}

$out->spew_utf8(<<~"END");
  <!doctype html>
  <html lang="en">
  <head>
  <meta charset="utf-8">
  <title>Private photos ($total)</title>
  <style>
    :root { color-scheme: light dark; --muted: #777; }
    body { font: 14px/1.4 system-ui, sans-serif; margin: 1.5rem; }
    h1 { font-size: 1.4rem; }
    h2 { font-size: 1.1rem; margin-top: 2rem; }
    h2 span, figcaption .id { color: var(--muted); font-weight: normal; }
    p { color: var(--muted); max-width: 45em; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; }
    figure { margin: 0; }
    figure img { width: 100%; height: 180px; object-fit: contain; background: rgba(128,128,128,.12); }
    figcaption { font-size: 12px; margin-top: 4px; overflow-wrap: anywhere; }
    .none { height: 180px; display: grid; place-items: center; color: var(--muted); background: rgba(128,128,128,.12); }
  </style>
  </head>
  <body>
  <h1>Private photos <span style="color: var(--muted); font-weight: normal">$total</span></h1>
  <p>Grouped by each photo's privacy level on Flickr, then by date.  To make one
  public, follow its id to its metadata file, change <code>visibility</code> to
  <code>"public"</code>, and build.  This page reads the library directly, so it
  works only on this machine, and is never published.</p>
  @{[ join "\n", @sections ]}
  </body>
  </html>
  END

say "wrote $out: $total private photo(s) in " . scalar(@order) . " group(s)";
